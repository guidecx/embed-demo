# --- 2.0 Customer Portal ---
# Needs a workspace-member API token. The minted embed token is valid for one minute.
GUIDECX_API_URL=https://api.guidecx.com/api/v3/members/embed-token
GUIDECX_API_TOKEN=

# GUIDEcx app that serves the embedded portal. MUST match the environment of the API above.
GUIDECX_APP_URL=https://app.guidecx.com/

# Customer to sign in as. Must already be shared on at least one project.
GUIDECX_CUSTOMER_EMAIL=

# --- Optional: legacy 1.0 Compass portal ---
# Setting these adds a 1.0 panel and a version toggle to the page.
# Needs the legacy Open API token from GUIDEcx Admin Settings; the 2.0 and 1.0
# tokens are not interchangeable.
#GUIDECX_LEGACY_API_URL=https://api.guidecx.com/api/v2/users/embed-token
#GUIDECX_LEGACY_API_TOKEN=
